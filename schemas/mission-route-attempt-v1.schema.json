{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://atlas.local/schemas/mission-route-attempt-v1.schema.json",
  "title": "Atlas Mission Route Attempt V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "route_id", "ordinal", "stage", "status", "failed_capability", "evidence_refs", "observed_head", "next_route_disposition", "attempted_at"],
  "properties": {
    "schema_version": {"const": "atlas.mission-route-attempt.v1"},
    "route_id": {"type": "string", "minLength": 2, "maxLength": 160},
    "ordinal": {"type": "integer", "minimum": 1},
    "stage": {"enum": ["MISSION_READ", "CHECKPOINT", "SOURCE_CONSTRUCTION", "COMPILATION", "VALIDATION", "PUBLICATION", "REVIEW", "READY", "PERMANENCE", "CANONICAL_READBACK", "PREVIEW", "APPROVAL"]},
    "status": {"enum": ["PENDING", "IN_PROGRESS", "SUCCEEDED", "REJECTED_CAPABILITY", "REJECTED_SAFETY", "REJECTED_AUTHORITY", "REJECTED_DRIFT", "TRANSFER_REQUIRED"]},
    "failed_capability": {"type": ["string", "null"], "minLength": 1},
    "evidence_refs": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "observed_head": {"oneOf": [{"type": "null"}, {"type": "string", "pattern": "^[a-f0-9]{40}$"}]},
    "next_route_disposition": {"type": "string", "minLength": 1},
    "attempted_at": {"type": "string", "format": "date-time"}
  }
}
