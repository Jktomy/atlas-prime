{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://atlas.local/schemas/rimuru-registry-v1.schema.json",
  "title": "Rimuru Registry v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "authority",
    "registry_id",
    "registry_revision",
    "quest_id",
    "operation",
    "record_root",
    "code_capsule_root",
    "entries",
    "lineage"
  ],
  "properties": {
    "schema_version": {
      "const": "atlas.rimuru.registry.v1"
    },
    "authority": {
      "const": "NONCANONICAL_EXTERNAL_INTELLIGENCE"
    },
    "registry_id": {
      "const": "RIMURU-REGISTRY-R01"
    },
    "registry_revision": {
      "type": "integer",
      "minimum": 1
    },
    "quest_id": {
      "const": "QUEST-CIELS-AWAKENING-20260724"
    },
    "operation": {
      "const": "Operation Ciel"
    },
    "record_root": {
      "const": "knowledge/rimuru/records"
    },
    "code_capsule_root": {
      "const": "knowledge/rimuru/code-capsules"
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "record_id",
          "record_type",
          "path",
          "source_locator",
          "source_revision",
          "license_status",
          "status"
        ],
        "properties": {
          "record_id": {
            "type": "string",
            "pattern": "^[A-Z0-9][A-Z0-9-]{2,127}$"
          },
          "record_type": {
            "enum": [
              "HARVEST",
              "ABSORPTION",
              "CODE_CAPSULE"
            ]
          },
          "path": {
            "type": "string",
            "pattern": "^knowledge/rimuru/(records|code-capsules)/[a-z0-9][a-z0-9-]*\\.json$"
          },
          "source_locator": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "source_revision": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 160
          },
          "license_status": {
            "enum": [
              "VERIFIED",
              "NOT_APPLICABLE"
            ]
          },
          "status": {
            "enum": [
              "DRAFT",
              "REVIEWED",
              "SUPERSEDED",
              "REJECTED"
            ]
          }
        }
      }
    },
    "lineage": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "repository",
          "revision",
          "path",
          "disposition",
          "successor"
        ],
        "properties": {
          "repository": {
            "type": "string",
            "minLength": 1
          },
          "revision": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$"
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "disposition": {
            "enum": [
              "REMODEL",
              "ADAPT",
              "REFERENCE_ONLY",
              "EXCLUDE"
            ]
          },
          "successor": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
