{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://atlas.local/schemas/ciel-absorption-record-v1.schema.json",
  "title": "Operation Ciel Absorption Record v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "absorption_id",
    "source_harvest_id",
    "created_at",
    "findings",
    "authority_boundary",
    "status"
  ],
  "properties": {
    "schema_version": {
      "const": "atlas.ciel.absorption-record.v1"
    },
    "absorption_id": {
      "type": "string",
      "pattern": "^ABSORB-[A-Z0-9-]{3,120}-R[0-9]{2}$"
    },
    "source_harvest_id": {
      "type": "string",
      "pattern": "^HARVEST-[A-Z0-9-]{3,120}-R[0-9]{2}$"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "findings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "finding_id",
          "summary",
          "disposition",
          "owner",
          "benefit",
          "risk",
          "validation",
          "rollback",
          "follow_on_required"
        ],
        "properties": {
          "finding_id": {
            "type": "string",
            "pattern": "^FINDING-[A-Z0-9-]{3,120}$"
          },
          "summary": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "disposition": {
            "enum": [
              "INTERNALIZE",
              "ADAPT",
              "INTEGRATE",
              "EXPERIMENT",
              "PRESERVE",
              "REJECT"
            ]
          },
          "owner": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "benefit": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "risk": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "validation": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "rollback": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "follow_on_required": {
            "type": "boolean"
          }
        }
      }
    },
    "authority_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "self_promotion",
        "build_authorized",
        "runtime_authorized",
        "permanence_authorized"
      ],
      "properties": {
        "self_promotion": {
          "const": false
        },
        "build_authorized": {
          "const": false
        },
        "runtime_authorized": {
          "const": false
        },
        "permanence_authorized": {
          "const": false
        }
      }
    },
    "status": {
      "enum": [
        "DRAFT",
        "REVIEWED",
        "SUPERSEDED",
        "REJECTED"
      ]
    }
  }
}
