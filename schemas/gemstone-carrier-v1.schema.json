{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://atlas.local/schemas/gemstone-carrier-v1.schema.json",
  "title": "Atlas Gemstone Carrier v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "carrier_id", "carrier_class", "mission_id", "attempt_id",
    "created_at", "producer", "classification", "manifest_digest", "payload",
    "sources", "custody", "validation", "recovery"
  ],
  "properties": {
    "schema_version": {"const": "atlas.gemstone.carrier.v1"},
    "carrier_id": {"type": "string", "pattern": "^[A-Z0-9][A-Z0-9-]{2,127}$"},
    "carrier_class": {"enum": ["ORIGINAL", "WORKING", "WORLDHOPPER"]},
    "mission_id": {"type": "string", "minLength": 1},
    "attempt_id": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "format": "date-time"},
    "producer": {
      "type": "object", "additionalProperties": false,
      "required": ["declared_worker", "credential_principal", "surface"],
      "properties": {
        "declared_worker": {"type": "string", "minLength": 1},
        "credential_principal": {"type": "string", "minLength": 1},
        "surface": {"type": "string", "minLength": 1}
      }
    },
    "classification": {"enum": ["PROTECTED_ORIGINAL", "PROTECTED_WORKING", "SANITIZED_WORLDHOPPER"]},
    "manifest_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "payload": {
      "type": "object", "additionalProperties": false,
      "required": ["sha256", "byte_length", "media_type", "private_pointer", "embedded_in_public_clean"],
      "properties": {
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "byte_length": {"type": "integer", "minimum": 0},
        "media_type": {"type": "string", "minLength": 1},
        "private_pointer": {"type": ["string", "null"], "pattern": "^protected://[A-Za-z0-9._/-]+$"},
        "embedded_in_public_clean": {"const": false}
      }
    },
    "sources": {
      "type": "array", "uniqueItems": true,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["carrier_id", "sha256", "relationship"],
        "properties": {
          "carrier_id": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "relationship": {"enum": ["ORIGINAL_OF", "DERIVED_FROM", "SANITIZED_FROM", "RETURNED_FROM"]}
        }
      }
    },
    "derivation": {
      "type": ["object", "null"], "additionalProperties": false,
      "required": ["method", "tool_identity", "output_digest", "limitations", "human_verified"],
      "properties": {
        "method": {"type": "string", "minLength": 1},
        "tool_identity": {"type": "string", "minLength": 1},
        "output_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "limitations": {"type": "string", "minLength": 1},
        "human_verified": {"type": "boolean"}
      }
    },
    "worldhopper": {
      "type": ["object", "null"], "additionalProperties": false,
      "required": ["recipient", "purpose", "allowed_fields", "excluded_classes", "expires_at", "return_route", "sanitization_receipt"],
      "properties": {
        "recipient": {"type": "string", "minLength": 1},
        "purpose": {"type": "string", "minLength": 1},
        "allowed_fields": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "excluded_classes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "expires_at": {"type": "string", "format": "date-time"},
        "return_route": {"const": "EMBERDARK_QUARANTINE_TENSOON_VERIFY"},
        "sanitization_receipt": {"type": "string", "minLength": 1}
      }
    },
    "custody": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["event", "actor", "timestamp", "receipt"],
        "properties": {
          "event": {"enum": ["ACQUIRED", "DERIVED", "SANITIZED", "DELIVERED", "QUARANTINED", "VERIFIED", "REVOKED", "DESTROYED"]},
          "actor": {"type": "string", "minLength": 1},
          "timestamp": {"type": "string", "format": "date-time"},
          "receipt": {"type": "string", "minLength": 1}
        }
      }
    },
    "validation": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "replay_checked", "tamper_checked", "sanitization_checked", "quarantine_status"],
      "properties": {
        "status": {"enum": ["PENDING", "PASS", "FAIL", "UNREADABLE"]},
        "replay_checked": {"type": "boolean"},
        "tamper_checked": {"type": "boolean"},
        "sanitization_checked": {"type": "boolean"},
        "quarantine_status": {"enum": ["NOT_APPLICABLE", "PENDING", "QUARANTINED", "RELEASED", "REJECTED"]}
      }
    },
    "recovery": {
      "type": "object", "additionalProperties": false,
      "required": ["model_independent", "original_retrievable", "instructions", "encryption_disposition"],
      "properties": {
        "model_independent": {"const": true},
        "original_retrievable": {"type": "boolean"},
        "instructions": {"type": "string", "minLength": 1},
        "encryption_disposition": {"enum": ["DEFERRED_DECISION_GATE", "EXTERNALLY_MANAGED", "NOT_APPLICABLE"]}
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"carrier_class": {"const": "ORIGINAL"}}},
      "then": {
        "properties": {
          "classification": {"const": "PROTECTED_ORIGINAL"},
          "sources": {"maxItems": 0},
          "derivation": {"type": "null"},
          "worldhopper": {"type": "null"}
        },
        "required": ["derivation", "worldhopper"]
      }
    },
    {
      "if": {"properties": {"carrier_class": {"const": "WORKING"}}},
      "then": {
        "properties": {
          "classification": {"const": "PROTECTED_WORKING"},
          "sources": {"minItems": 1},
          "derivation": {"type": "object"},
          "worldhopper": {"type": "null"}
        },
        "required": ["derivation", "worldhopper"]
      }
    },
    {
      "if": {"properties": {"carrier_class": {"const": "WORLDHOPPER"}}},
      "then": {
        "properties": {
          "classification": {"const": "SANITIZED_WORLDHOPPER"},
          "sources": {"minItems": 1},
          "worldhopper": {"type": "object"}
        },
        "required": ["worldhopper"]
      }
    }
  ]
}
